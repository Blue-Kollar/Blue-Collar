{
  "name": "@bluecollar/api",
  "version": "1.0.0",
  "description": "Backend API for BlueCollar - a decentralized protocol connecting local skilled workers with users",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run src/__tests__/performance",
    "migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx src/database/seed.ts",
    "seed:reset": "tsx src/database/seed.ts --reset",
    "seed:reviews": "tsx src/database/seed.ts --reviews",
    "seed:full": "tsx src/database/seed.ts --reviews",
    "seed:staging": "tsx src/database/seed-staging.ts",
    "admin:create": "tsx src/commands/create-admin.ts",
    "db:reset": "tsx src/commands/reset-db.ts",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "audit": "pnpm audit --audit-level=high",
    "audit:fix": "pnpm audit --fix",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --reporters json,clear-text"
  },
  "prisma": {
    "seed": "tsx src/database/seed.ts"
  },
  "keywords": [
    "skilled-workers",
    "stellar",
    "decentralized",
    "marketplace"
  ],
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@bluecollar/types": "workspace:*",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.45.0",
    "@opentelemetry/instrumentation-express": "^0.34.1",
    "@opentelemetry/instrumentation-http": "^0.46.0",
    "@opentelemetry/instrumentation-pg": "^0.37.2",
    "@opentelemetry/resources": "^1.19.0",
    "@opentelemetry/sdk-node": "^0.45.0",
    "@opentelemetry/sdk-trace-base": "^1.19.0",
    "@opentelemetry/semantic-conventions": "^1.21.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "argon2": "^0.41.1",
    "bullmq": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "node-vault": "^0.12.0",
    "nodemailer": "^6.9.9",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "5.0.1",
    "v8-profiler-next": "^1.9.0",
    "web-push": "^3.6.7",
    "xss": "^1.0.15",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@bluecollar/test-utils": "workspace:*",
    "@bluecollar/types": "workspace:*",
    "@faker-js/faker": "^10.2.0",
    "@stryker-mutator/core": "^8.2.6",
    "@stryker-mutator/vitest-runner": "^8.2.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6",
    "@types/passport": "^0",
    "@types/passport-google-oauth20": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.3",
    "prisma": "^7.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
