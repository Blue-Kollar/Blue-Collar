# ─── Database ────────────────────────────────────────────────────────────────

# [required] Primary (read-write) PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/bluecollar"

# [optional] Read-replica connection string.
# When set, all read-only queries are routed here. Falls back to DATABASE_URL.
DATABASE_READ_URL=""

# [optional] Shadow database used only by Prisma migrations (never production data).
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/bluecollar_test"

# [optional] Primary pool size (default: 10)
DB_POOL_SIZE=10

# [optional] Read-replica pool size (default: 20)
DB_READ_POOL_SIZE=20

# ─── Authentication ───────────────────────────────────────────────────────────

# [required] Secret key used to sign JSON Web Tokens — use a long random value in production.
JWT_SECRET="change-me-in-production"

# ─── Application ─────────────────────────────────────────────────────────────

# [optional] API server port (default: 3000)
PORT=3000

# [optional] Runtime environment: development | test | production
NODE_ENV="development"

# [required] Public URL of the frontend — used in emails and OAuth redirects.
APP_URL="http://localhost:3001"

# [optional] Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# [optional] Directory for log files (default: storage/logs)
LOG_DIR="storage/logs"

# [optional] Comma-separated list of CORS-allowed origins.
ALLOWED_ORIGINS="http://localhost:3001"

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# [optional] Rate limit window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# [optional] Maximum requests per IP within the window (default: 100)
RATE_LIMIT_MAX=100

# ─── Redis ────────────────────────────────────────────────────────────────────

# [optional] Redis connection URL — used for caching and rate limiting.
REDIS_URL="redis://localhost:6379"

# ─── File Uploads ─────────────────────────────────────────────────────────────

# [optional] Upload storage directory (default: storage/uploads)
UPLOAD_DIR="storage/uploads"

# [optional] Maximum upload size in bytes (default: 5 MB = 5242880)
MAX_FILE_SIZE=5242880

# ─── Google OAuth ─────────────────────────────────────────────────────────────

# [required] OAuth 2.0 credentials from Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Email / SMTP ─────────────────────────────────────────────────────────────

# [required] SMTP configuration for outgoing email.
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="no-reply@example.com"
MAIL_PASS="your-smtp-password"

# ─── Web Push Notifications ───────────────────────────────────────────────────

# [optional] VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── Stellar / Horizon ────────────────────────────────────────────────────────

# [optional] Horizon API base URL (default: testnet)
HORIZON_URL="https://horizon-testnet.stellar.org"

# [optional] Stellar network: testnet | mainnet (default: testnet)
STELLAR_NETWORK="testnet"

# [optional] Soroban contract IDs — leave empty until deployed.
REGISTRY_CONTRACT_ID=""
MARKET_CONTRACT_ID=""

# ─── Background Workers ───────────────────────────────────────────────────────

# [optional] Graceful shutdown timeout in milliseconds (default: 30000)
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ─── Vault (HashiCorp) ────────────────────────────────────────────────────────

# [optional] Vault server address (default: http://localhost:8200)
VAULT_ADDR="http://localhost:8200"

# [optional] Vault token — omit in local dev if Vault is not running.
VAULT_TOKEN=""

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────

# [optional] S3 region (default: us-east-1)
S3_REGION="us-east-1"

# [optional] Custom S3-compatible endpoint (leave empty for AWS S3).
S3_ENDPOINT=""

# [optional] S3 access credentials — leave empty to use IAM role in production.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# [optional] S3 bucket name.
S3_BUCKET=""

# [optional] Signed URL TTL in seconds (default: 3600 = 1 hour)
S3_SIGNED_URL_TTL=3600

# ─── Seed / Fixtures (seed.ts only — not read by production code) ─────────────

# Admin account created by `pnpm seed`.
SEED_ADMIN_EMAIL="admin@bluecollar.dev"
SEED_ADMIN_PASSWORD=""

# Curator accounts.
SEED_CURATOR1_EMAIL="curator1@bluecollar.dev"
SEED_CURATOR1_PASSWORD=""
SEED_CURATOR2_EMAIL="curator2@bluecollar.dev"
SEED_CURATOR2_PASSWORD=""
SEED_CURATOR3_EMAIL="curator3@bluecollar.dev"
SEED_CURATOR3_PASSWORD=""
