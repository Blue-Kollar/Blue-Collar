{
  "name": "@bluecollar/types",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared TypeScript types, DTOs, and validation schemas for BlueCollar API and App",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validations": "./src/validations.ts"
  },
  "scripts": {
