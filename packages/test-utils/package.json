{
  "name": "@bluecollar/test-utils",
  "version": "1.0.0",
  "description": "Shared test utilities, factories, and render helpers for BlueCollar packages",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./react": "./src/react/index.ts",
    "./express": "./src/express/index.ts",
    "./contract-fixtures": "./src/contract-fixtures.ts",
    "./stellar-mocks": "./src/stellar-mocks.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bluecollar/types": "workspace:*",
    "@faker-js/faker": "^9.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
