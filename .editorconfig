# EditorConfig: https://editorconfig.org
#
# This is the source of truth for indentation, charset, and line-ending
# rules across every editor and OS. Prettier enforces the same rules for
# files it handles; .editorconfig covers everything Prettier does not
# (Rust, TOML, YAML, Makefiles, etc.).

root = true

# ─── Defaults for all files ───────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ─── Rust / TOML ──────────────────────────────────────────────────────
[*.{rs,toml}]
indent_size = 4

# ─── YAML ─────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── Markdown ─────────────────────────────────────────────────────────
# Trailing whitespace is meaningful in Markdown (line breaks)
[*.md]
trim_trailing_whitespace = false

# ─── Makefile ─────────────────────────────────────────────────────────
[Makefile]
indent_style = tab

# ─── Shell scripts ────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# ─── Lock files and generated artifacts ───────────────────────────────
[{pnpm-lock.yaml,package-lock.json,Cargo.lock}]
insert_final_newline = true
