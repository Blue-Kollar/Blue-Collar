{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs,cjs,ts}"],
      "project": ["*.{js,mjs,cjs,ts}", "scripts/**/*.{js,mjs,cjs,ts}"]
    },
    "packages/api": {
      "entry": [
        "src/index.ts",
        "src/commands/**/*.ts",
        "src/scripts/**/*.ts",
        "src/**/*.test.ts",
        "src/__tests__/**/*.ts",
        "vitest*.config.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/app": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/middleware.ts",
        "src/instrumentation.ts",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.ts",
        "e2e/**/*.tsx",
        "*.config.{js,mjs,ts}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,tsx}"]
    },
    "packages/mobile": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "jest.setup.ts",
        "babel.config.js"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/monitoring": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/test-utils": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/types": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/__tests__/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": [],
      "project": []
    }
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.next/**",
    "**/.expo/**",
    "**/storybook-static/**",
    "**/public/**",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "eslint-*",
    "prettier",
    "typescript",
    "vitest",
    "jest",
    "tsup",
    "turbo"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
