# Third-party dependencies — never lint vendor code.
node_modules

# Compiled TypeScript output — lint the source, not the build artefacts.
dist

# Next.js build cache and output — generated by `next build`, not source.
.next

# Generic build output directory (used by some packages).
build

# Test coverage reports generated by vitest/c8 — not source.
coverage

# pnpm lockfile — auto-generated, linting it provides no value.
pnpm-lock.yaml

# Any other package-manager lockfiles (yarn.lock, package-lock.json, etc.)
*.lock
