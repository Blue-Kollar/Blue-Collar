# Stellar network: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in the values for your local environment.
# Never commit real secrets. Placeholders below are safe defaults.
#
# Legend:
#   [required] - must be set for the app/API to start
#   [optional] - has a sensible default or is only needed for specific features
# =============================================================================

# -----------------------------------------------------------------------------
# General / Runtime
# -----------------------------------------------------------------------------
# [optional] Node environment: "development", "test", or "production"
NODE_ENV=development

# [optional] Log verbosity: "debug", "info", "warn", "error"
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Stellar Network (frontend + backend)
# -----------------------------------------------------------------------------
# [required] Stellar network to target: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# [optional] Stellar RPC/Horizon endpoint used by the API
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# [optional] Public RPC URL exposed to the frontend
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# [optional] Soroban contract IDs (leave empty until deployed)
REGISTRY_CONTRACT_ID=
MARKET_CONTRACT_ID=

# [optional] Public contract IDs exposed to the frontend
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_MARKET_CONTRACT_ID=

# -----------------------------------------------------------------------------
# Database (packages/api)
# -----------------------------------------------------------------------------
# [required] Primary PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar?schema=public

# [optional] Shadow database used by Prisma migrations
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_shadow?schema=public

# -----------------------------------------------------------------------------
# Authentication / Security (packages/api)
# -----------------------------------------------------------------------------
# [required] Secret used to sign JWTs — replace with a strong random value
JWT_SECRET=changeme

# [optional] JWT expiry (e.g., "1h", "7d")
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Cache / Queue (packages/api)
# -----------------------------------------------------------------------------
# [optional] Redis connection string
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Mail (packages/api)
# -----------------------------------------------------------------------------
# [optional] SMTP configuration for outgoing email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Frontend (packages/app)
# -----------------------------------------------------------------------------
# [optional] Public base URL of the API consumed by the frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# [optional] Public app URL (used for links, OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Monitoring (packages/monitoring)
# -----------------------------------------------------------------------------
# [optional] Sentry DSN for error reporting (leave empty to disable)
SENTRY_DSN=

# [optional] Public Sentry DSN exposed to the frontend
NEXT_PUBLIC_SENTRY_DSN=

# [optional] Environment tag reported to monitoring tools
SENTRY_ENVIRONMENT=development

# [optional] Prometheus/metrics port
METRICS_PORT=9090